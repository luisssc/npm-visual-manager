{
  "name": "npm-visual-manager",
  "displayName": "NPM Visual Manager",
  "description": "Manage NPM dependencies with a visual interface like NuGet Package Manager",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:npm-gui-manager.openManager"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "npm-visual-manager.openManager",
        "title": "Open NPM Package Manager",
        "icon": "$(package)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "npm-visual-manager.openManager"
        }
      ],
      "explorer/context": [
        {
          "command": "npm-visual-manager.openManager",
          "when": "resourceFilename == package.json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview-ui && npm run build",
    "build:webview:dev": "cd webview-ui && npm run build:dev",
    "install:all": "npm install && cd webview-ui && npm install",
    "dev": "npm run build:webview:dev && npm run compile"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
